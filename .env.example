# Vercel AI Gateway API key (use a dedicated key with a non-resetting budget).
AI_GATEWAY_API_KEY=
JEV_MODEL=typesafe-ai/jev
# Hard project-wide cap. Must never be exceeded.
EXPERIMENT_BUDGET_USD=5.00
# App-side stop threshold (safety margin below the hard cap).
EXPERIMENT_STOP_THRESHOLD_USD=4.50
# Live JEV tests are skipped unless this is set to 1.
RUN_LIVE_JEV_TESTS=0
